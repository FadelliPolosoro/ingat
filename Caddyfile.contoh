# Tambahkan ke /etc/caddy/Caddyfile di VPS (Caddy otomatis mengurus sertifikat TLS lewat Let's Encrypt).
# Ganti "memori.contoh-domain.id" dengan salah satu:
#   - subdomain milikmu sendiri, A record -> IP VPS ini, ATAU
#   - <ip-dengan-strip>.sslip.io (mis. 187-52-125-35.sslip.io) — tanpa domain, tanpa konfigurasi DNS apa
#     pun, langsung bisa dipakai (lihat pasang/README-google-auth.md).
# Google OAuth WAJIB HTTPS untuk redirect_uri (kecuali localhost) — karena itu Caddy di sini penting,
# bukan sekadar mempercantik alamat.
memori.contoh-domain.id {
    encode zstd gzip
    # Batasi ukuran body di sisi proxy juga
    request_body {
        max_size 2MB
    }
    reverse_proxy 127.0.0.1:8765 {
        header_up X-Forwarded-For {remote_host}
        transport http {
            read_timeout 60s
        }
    }
}
# Setelah ini aktif, set "server.proxy_tepercaya": true di konfigurasi.json
# supaya rate limit membaca IP klien dari entri TERAKHIR X-Forwarded-For.

# --- Custom Connector claude.ai (MCP Streamable HTTP di /mcp) ---
# PENTING: token ada literal di path (/mcp/<token>) bila kamu pakai jalur URL-rahasia.
# log_message di ingat/api.py sudah meredaksinya (K19), tapi Caddy TIDAK TAHU itu — access log Caddy
# akan mencatat path mentah kecuali kamu matikan/saring log untuk path ini secara eksplisit:
memori.contoh-domain.id {
    encode zstd gzip
    request_body { max_size 2MB }

    @mcp path /mcp /mcp/*
    handle @mcp {
        log_skip   # tidak ada access log sama sekali untuk /mcp — token tidak pernah tersimpan di disk Caddy
        reverse_proxy 127.0.0.1:8765 {
            header_up X-Forwarded-For {remote_host}
            transport http { read_timeout 60s }
        }
    }
    handle {
        reverse_proxy 127.0.0.1:8765 {
            header_up X-Forwarded-For {remote_host}
            transport http { read_timeout 60s }
        }
    }
}
