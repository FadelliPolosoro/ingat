{
  "_catatan": "PENAMPUNG: `python3` di setiap command SELALU diganti penafsir mesin pemasang oleh ingat/pasang.py (terapkan_penafsir). Jangan menyalin berkas ini apa adanya ke ~/.claude/settings.json — di Windows `python3` jatuh ke stub Microsoft Store dan hook gagal diam-diam. Kunci ini diabaikan oleh gabung_hooks.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m ingat.tangkap PostToolUse",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m ingat.tangkap PostToolUseFailure",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m ingat.tangkap Stop",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m ingat.tangkap UserPromptSubmit",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m ingat.tangkap SessionEnd",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m ingat.tangkap SessionStart",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
