# Salin ke .env — JANGAN commit .env
# Token API (wajib, >= 24 karakter). Buat: python3 -m ingat token
INGAT_TOKEN=

# Vault Obsidian di host (folder yang disinkron ke laptop/HP lewat Obsidian Sync, LiveSync, atau git)
INGAT_VAULT_HOST=./vault

# Kunci penyedia LLM — isi hanya yang dipakai. Kosong = penyedia dilewati (bukan galat).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
XAI_API_KEY=
ZHIPU_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=
LOKAL_API_KEY=

# Embedding via HTTP (opsional; kosong = penyemat lokal tanpa model)
EMBEDDING_API_KEY=

# Google Auth untuk dashboard (K25) — kosongkan semua untuk mematikan (dashboard pakai token saja).
# Cara dapat: pasang/README-google-auth.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Wajib diisi kalau GOOGLE_CLIENT_ID diisi (>= 24 karakter). Buat: python3 -m ingat token
INGAT_SESI_RAHASIA=
# Verifikasi dua langkah MANDIRI (K26) — tidak bergantung Google. Buat: python3 -m ingat totp-atur
INGAT_TOTP_RAHASIA=
